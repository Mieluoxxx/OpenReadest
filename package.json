{
  "name": "@openreadest/monorepo",
  "private": true,
  "repository": "Mieluoxxx/openreadest",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "node scripts/init-submodules.mjs && pnpm install",
    "clean": "pnpm --filter @openreadest/app run clean",
    "dev": "pnpm run clean fd && pnpm tauri dev",
    "setup-vendors": "pnpm --filter @openreadest/app setup-vendors",
    "tauri": "pnpm --filter @openreadest/app tauri",
    "tauri-dev-clean": "pnpm --filter @openreadest/app tauri-dev-clean",
    "tauri-dev-clean-deep": "pnpm --filter @openreadest/app tauri-dev-clean-deep",
    "dev-web": "pnpm --filter @openreadest/app dev-web",
    "build": "pnpm --filter @openreadest/app build",
    "build-web": "pnpm --filter @openreadest/app build-web",
    "check:all": "pnpm --filter @openreadest/app check:all",
    "lint": "pnpm --filter @openreadest/app lint",
    "test": "pnpm --filter @openreadest/app test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.9.1",
    "@sindresorhus/tsconfig": "^6.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5"
  }
}
