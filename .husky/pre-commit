#!/usr/bin/env sh
#
# Formats staged files with Prettier before committing.
#
# Only staged files are touched, and only the extensions Prettier is configured
# for (see the "format" script in the root package.json). Files reformatted here
# are re-staged, so the commit always contains formatted code and CI's
# `pnpm format:check` cannot fail on it.

staged=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '\.(js|jsx|ts|tsx|css|json|md|html|yml)$' || true)

[ -z "$staged" ] && exit 0

# NUL-delimit the file list so paths containing spaces (e.g.
# ".trellis/workspace/Morgan Woods/...") are passed as single arguments.
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 pnpm exec prettier --write --ignore-unknown
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add
